{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "ErrorLogs/log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=172.20.10.3,1433;Database=KanhaDairyDB;User Id=dockeruser;Password=Docker@123;TrustServerCertificate=true",
          "tableName": "ErrorLogs",
          "autoCreateSqlTable": false
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*", //servername       dbname           windosauthentication                               ssl certification
  "ConnectionStrings": {
    "SqlConnection": "Server=172.20.10.3,1433;Database=KanhaDairyDB;User Id=dockeruser;Password=Docker@123;TrustServerCertificate=true;MultipleActiveResultSets=True;"
  } /// for using window authentication
  //"ConnectionStrings": { "SqlConnection": "Server=KANHA;Database=KanhaDairyDB;User id=sa;Password=sa@123" } /// for using sql server authentication
}
